<div class="tool-panel flex flex-col gap-4">
	<div class="flex items-center gap-2">
		<output id="pw" class="flex-1 min-w-0 font-mono text-lg md:text-xl break-all tool-heading py-1"></output>
		<button type="button" class="tool-btn" id="regen" title="Generate another" aria-label="Generate another"><span class="i-myna-refresh w-5 h-5"></span></button>
		<button type="button" class="tool-btn" data-copy="#pw" aria-label="Copy password"><span class="i-myna-copy w-5 h-5"></span></button>
	</div>
	<div>
		<div class="h-1.5 rounded-full bg-#8882 overflow-hidden">
			<div id="meter" class="h-full rounded-full transition-all duration-300"></div>
		</div>
		<p id="strength" class="text-sm mt-2 mb-0"></p>
	</div>
</div>

<div class="grid md:grid-cols-2 gap-4">
	<div class="flex flex-col gap-3">
		<div class="inline-flex flex-wrap rounded-md bg-#8881 p-0.5 self-start" role="group" aria-label="Preset">
			<button type="button" class="tool-btn bg-transparent" data-preset="password">Password</button>
			<button type="button" class="tool-btn bg-transparent" data-preset="pin">PIN</button>
			<button type="button" class="tool-btn bg-transparent" data-preset="hex">Hex token</button>
			<button type="button" class="tool-btn bg-transparent" data-preset="key">API key</button>
		</div>
		<label class="block">
			<span class="tool-label">Length: <span id="len-val" class="normal-case"></span></span>
			<input id="length" type="range" min="4" max="128" value="20" class="w-full accent-current" />
		</label>
		<div class="flex flex-wrap gap-2">
			<label class="tool-btn"><input type="checkbox" id="lower" checked /> a–z</label>
			<label class="tool-btn"><input type="checkbox" id="upper" checked /> A–Z</label>
			<label class="tool-btn"><input type="checkbox" id="digits" checked /> 0–9</label>
			<label class="tool-btn"><input type="checkbox" id="symbols" checked /> !@#$</label>
			<label class="tool-btn" title="Excludes I l 1 O 0 o | ` ' &quot;"><input type="checkbox" id="ambiguous" /> No look-alikes</label>
		</div>
		<label class="block">
			<span class="tool-label">Custom characters <span class="normal-case opacity-70">(added to the sets above)</span></span>
			<input id="custom" class="tool-field py-1.5" spellcheck="false" autocomplete="off" />
		</label>
		<label class="block">
			<span class="tool-label">Prefix</span>
			<input id="prefix" class="tool-field py-1.5" placeholder="e.g. sk_live_" spellcheck="false" autocomplete="off" />
		</label>
	</div>
	<div>
		<div class="flex items-center justify-between">
			<span class="tool-label">More like this</span>
			<button type="button" class="tool-btn py-0.5 px-2 text-xs mb-1" data-copy="#bulk"><span class="i-myna-copy w-3.5 h-3.5"></span>Copy</button>
		</div>
		<pre id="bulk" class="tool-field m-0 h-64 overflow-auto leading-relaxed"></pre>
	</div>
</div>

<script>
	import { $, $$, mountTool } from "../../../lib/tools/dom";
	import { buildAlphabet, crackTime, entropyBits, generatePassword, strengthLabel, type PasswordOptions } from "../../../lib/tools/password";

	const COLORS = ["bg-red-500", "bg-orange-500", "bg-yellow-500", "bg-green-500", "bg-emerald-500"];

	mountTool("password", (root) => {
		const length = $<HTMLInputElement>(root, "#length");
		const boxes = Object.fromEntries(["lower", "upper", "digits", "symbols", "ambiguous"].map((id) => [id, $<HTMLInputElement>(root, "#" + id)]));
		const custom = $<HTMLInputElement>(root, "#custom");
		const prefix = $<HTMLInputElement>(root, "#prefix");

		const opts = (): PasswordOptions => ({
			length: Number(length.value),
			lower: boxes.lower.checked,
			upper: boxes.upper.checked,
			digits: boxes.digits.checked,
			symbols: boxes.symbols.checked,
			excludeAmbiguous: boxes.ambiguous.checked,
			custom: custom.value,
		});

		function run() {
			const o = opts();
			$(root, "#len-val").textContent = String(o.length);
			const alphabet = buildAlphabet(o);
			const pw = $(root, "#pw");
			if (alphabet.length < 2) {
				pw.textContent = "Select at least one character set";
				return;
			}
			const gen = () => prefix.value + generatePassword(o);
			pw.textContent = gen();
			$(root, "#bulk").textContent = Array.from({ length: 10 }, gen).join("\n");
			const bits = entropyBits(o.length, alphabet.length);
			const s = strengthLabel(bits);
			const meter = $(root, "#meter");
			meter.className = `h-full rounded-full transition-all duration-300 ${COLORS[s.level]}`;
			meter.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
			$(root, "#strength").innerHTML = `<b>${s.label}</b> · ${Math.round(bits)} bits of entropy from ${alphabet.length} possible characters · brute force at 100 billion guesses/s: ~${crackTime(bits)}`;
		}

		function preset(p: string) {
			const set = (len: number, l: boolean, u: boolean, d: boolean, sy: boolean, custom_ = "") => {
				length.value = String(len);
				boxes.lower.checked = l;
				boxes.upper.checked = u;
				boxes.digits.checked = d;
				boxes.symbols.checked = sy;
				custom.value = custom_;
			};
			if (p === "password") set(20, true, true, true, true);
			if (p === "pin") set(6, false, false, true, false);
			if (p === "hex") set(64, false, false, true, false, "abcdef");
			if (p === "key") set(32, true, true, true, false);
			$$<HTMLButtonElement>(root, "[data-preset]").forEach((b) => b.classList.toggle("tool-btn-active", b.dataset.preset === p));
			run();
		}

		[length, custom, prefix].forEach((el) => el.addEventListener("input", run));
		Object.values(boxes).forEach((el) => el.addEventListener("change", run));
		$(root, "#regen").addEventListener("click", run);
		$$<HTMLButtonElement>(root, "[data-preset]").forEach((b) => b.addEventListener("click", () => preset(b.dataset.preset!)));
		preset("password");
	});
</script>
