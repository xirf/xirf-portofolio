---
import Layout from "./Layout.astro";
import ToolPalette from "../components/tools/ToolPalette.astro";
import { tools, type Tool } from "../data/tools";

interface Props {
	tool: Tool;
}

const { tool } = Astro.props;
const sameCategory = tools.filter((t) => t.category === tool.category && t.slug !== tool.slug);
const others = tools.filter((t) => t.category !== tool.category);
// Same-category tools first, then a deterministic slice of the rest.
const offset = tools.findIndex((t) => t.slug === tool.slug);
const related = [
	...sameCategory,
	...others.slice(offset % others.length),
	...others.slice(0, offset % others.length),
].slice(0, 6);
---

<Layout title={`${tool.name} · Andka Tools`} description={tool.summary}>
	<div class="tool-page max-w-5xl mx-auto px-6 md:px-12 pt-8 md:pt-12 pb-24">
		<div class="slide-enter-content flex flex-col gap-6">
			<nav class="flex items-center justify-between gap-4 text-sm" aria-label="Breadcrumb">
				<a href="/tools" class="inline-flex items-center gap-1 opacity-70 hover:opacity-100 transition-opacity">
					<span class="i-myna-chevron-left w-4 h-4"></span>
					All tools
				</a>
				<button
					type="button"
					data-open-palette
					class="hidden sm:inline-flex items-center gap-2 text-xs opacity-60 hover:opacity-100 transition-opacity"
					title="Jump to another tool"
				>
					<span class="i-myna-search w-3.5 h-3.5"></span>
					Jump to tool
					<kbd class="font-mono rounded border border-#8883 px-1.5 py-0.5">Ctrl K</kbd>
				</button>
			</nav>

			<header class="flex flex-col gap-3">
				<div class="flex items-start gap-4">
					<span class:list={[tool.icon, "w-10 h-10 shrink-0 mt-1"]}></span>
					<div class="min-w-0">
						<p class="text-xs uppercase tracking-widest opacity-50">{tool.category}</p>
						<h1 class="text-3xl md:text-4xl tool-heading">{tool.name}</h1>
					</div>
				</div>
				<p class="max-w-3xl leading-relaxed">{tool.summary}</p>
				<div class="flex flex-wrap items-center gap-2 text-xs">
					<span class="tool-chip">
						<span class="i-myna-shield-check w-3.5 h-3.5"></span>
						Runs in your browser. Nothing is uploaded.
					</span>
					{
						tool.shareable && (
							<button id="tool-share" type="button" class="tool-chip hover:bg-#8881 transition-colors disabled:opacity-40" title="Copy a link that restores the current input">
								<span class="i-myna-share w-3.5 h-3.5" />
								Copy share link
							</button>
						)
					}
				</div>
			</header>

			<section data-tool={tool.slug} class="flex flex-col gap-4">
				<slot />
			</section>
		</div>

		<aside class="mt-20">
			<h2 class="tool-label">More tools</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
				{
					related.map((t) => (
						<a
							href={`/tools/${t.slug}`}
							class="flex items-center gap-3 rounded-md px-3 py-2.5 opacity-75 hover:(opacity-100 bg-#8881) transition-all"
						>
							<span class:list={[t.icon, "w-6 h-6 shrink-0"]} />
							<span class="min-w-0">
								<span class="block text-sm tool-heading">{t.name}</span>
								<span class="block text-xs opacity-70 truncate">{t.description}</span>
							</span>
						</a>
					))
				}
			</div>
		</aside>
	</div>

	<div
		id="tool-toast"
		role="status"
		aria-live="polite"
		data-show="false"
		class="fixed left-1/2 bottom-24 md:bottom-8 z-200 -translate-x-1/2 rounded-full bg-#1e1e2e text-#eff1f5 dark:(bg-#eff1f5 text-#1e1e2e) px-4 py-2 text-sm shadow-lg pointer-events-none transition-all duration-200"
	>
	</div>

	<ToolPalette />
</Layout>

<style is:global>
	#tool-toast[data-show="false"] {
		opacity: 0;
		transform: translate(-50%, 8px);
	}
	#tool-toast[data-show="true"] {
		opacity: 1;
		transform: translate(-50%, 0);
	}
	/* Shared look for highlighted matches, diffs etc. */
	.tool-mark {
		border-radius: 3px;
		background: #fde68a;
		color: #1e1e2e;
		box-shadow: 0 0 0 1px #f59e0b55;
	}
	.tool-mark.alt {
		background: #bfdbfe;
		box-shadow: 0 0 0 1px #3b82f655;
	}
	.dark .tool-mark {
		background: #a16207aa;
		color: #fef3c7;
	}
	.dark .tool-mark.alt {
		background: #1d4ed8aa;
		color: #dbeafe;
	}
	/* Grid children default to min-width:auto, which lets long text widen the page on phones. */
	.tool-page .grid > * {
		min-width: 0;
	}
	[data-tool] select.tool-field {
		font-family: inherit;
	}
	[data-tool] select.tool-field option {
		background: #eff1f5;
		color: #4c4f69;
	}
	.dark [data-tool] select.tool-field option {
		background: #111215;
		color: #9ca3af;
	}
</style>

<script>
	import { copyText, toast } from "../lib/tools/dom";
	import { pushRecent } from "../lib/tools/search";

	// Generic copy buttons: <button data-copy="#selector"> or <button data-copy-value="text">.
	document.addEventListener("click", (ev) => {
		const btn = (ev.target as HTMLElement).closest<HTMLElement>("[data-copy], [data-copy-value]");
		if (!btn) return;
		if (btn.dataset.copyValue !== undefined) {
			copyText(btn.dataset.copyValue);
			return;
		}
		const scope = btn.closest("[data-tool]") ?? document;
		const target = scope.querySelector<HTMLElement>(btn.dataset.copy!);
		if (!target) return;
		const text =
			target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement
				? target.value
				: (target.innerText ?? target.textContent ?? "");
		if (!text) return toast("Nothing to copy yet");
		copyText(text);
	});

	document.addEventListener("astro:page-load", () => {
		const root = document.querySelector<HTMLElement>("[data-tool]");
		if (!root) return;
		pushRecent(root.dataset.tool!);
		document.getElementById("tool-share")?.addEventListener("click", () => {
			if (!location.hash.startsWith("#s=")) return toast("Change something first, then share");
			copyText(location.href, "Share link copied");
		});
	});
</script>
